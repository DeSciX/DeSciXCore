{
  "name": "@descix/sdk",
  "version": "1.1.0",
  "description": "DeSciX SDK - Shared runtime libraries for Node.js and Browser",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./app": "./app/index.js",
    "./app/dev": "./app/dev.js",
    "./microservice": "./microservice/index.js",
    "./node": "./src/index.js",
    "./mcp/transports": "./mcp/transports/index.js",
    "./mcp/transports/stdio": "./mcp/transports/stdio-transport.js",
    "./mcp/transports/http-sse": "./mcp/transports/http-sse-transport.js",
    "./integrations/git": "./src/integrations/gitUtils.js",
    "./orchestrators/wizard": "./src/orchestrators/wizardOrchestrator.js",
    "./managers/community": "./src/managers/communityManager.js",
    "./managers/app": "./src/managers/appManager.js",
    "./mesh/asset": "./src/mesh/assetClient.js"
  },
  "keywords": [
    "descix",
    "sdk",
    "mcp",
    "rag",
    "git",
    "wizard"
  ],
  "author": "DeSciX",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "src",
    "mcp",
    "microservice",
    "app",
    "bin"
  ],
  "scripts": {
    "pack": "npm pack",
    "check:exports": "node scripts/check-exports-resolve-cli.mjs",
    "check:install-size": "node scripts/check-install-size-cli.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@descix/cloud-core": "^1.1.0"
  },
  "bin": {
    "descix-app": "bin/descix-app.js"
  },
  "peerDependencies": {
    "@descix/app-sdk": "^0.1.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@descix/app-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
