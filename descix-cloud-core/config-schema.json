{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "DeSciX Cloud Service Configuration Schema - Defines key categories for bootstrap and dev override",
  "version": "1.2.0",
  "bootstrap_keys": {
    "description": "Keys loaded from .env/.yaml BEFORE Secret Manager access (required for bootstrap)",
    "keys": [
      "CONFIG_SECRET_NAME",
      "CONFIG_SECRET_VERSION",
      "CONTRACT_SECRET_NAME",
      "DEPLOY_ENV",
      "IS_BOT_ENABLED",
      "BYPASS_PUBSUB",
      "DEBUG_FUNCTION_FRAMEWORK",
      "DEBUG_LOCAL",
      "DISCORD_BOT_URL",
      "POWCH_APP_URL",
      "PUB_SUB_DISCORD_BOT_REPLY",
      "PUB_SUB_DISCORD_EVENTS",
      "DISCORD_VERIFIED_ROLE_NAME"
    ]
  },
  "required_keys": {
    "description": "Keys that MUST resolve to a non-null value after bootstrap completes. CloudConfig.initialize() throws CloudConfigFatalError if any of these are null/undefined. Add a key here ONLY if a null value would cause silent runtime degradation (chat fall-through, opaque RAG/Firestore failures). Per `feedback_no_hardcoded_fallbacks` — surface misconfiguration loudly at boot, never paper over with defaults.",
    "keys": [
      "INTELLIGENCE_LEVELS",
      "DEFAULT_AI_MODEL",
      "DEFAULT_INTELLIGENCE_LEVEL",
      "PINECONE_INDEX_NAME",
      "PINECONE_API_KEY",
      "PINECONE_NAMESPACE_MODE",
      "PLATFORM_DEFAULT_CHAIN",
      "FIRESTORE_DATABASE_ID",
      "GOOGLE_PROJECT_ID",
      "GEMINI_API_KEY",
      "STORAGE_BUCKET"
    ]
  },
  "boolean_keys": {
    "description": "Keys that should be parsed as boolean (value === 'true')",
    "keys": [
      "DEBUG_LOCAL",
      "DEBUG_PROXY",
      "DEBUG_STREAMING",
      "IS_BOT_ENABLED",
      "DEBUG_FUNCTION_FRAMEWORK",
      "BYPASS_PUBSUB",
      "CLOUDFLARED_AUTO_START",
      "EMAIL_VERIFICATION_REQUIRED",
      "ENFORCE_ANY_TOKEN_GATE",
      "CRYPTOAPIS_WRITE_PATH_ENABLED",
      "BATCH_UPDATE_BALANCES_BROADCAST_ENABLED"
    ]
  },
  "dev_override_keys": {
    "description": "Keys that can be overridden via .env or dev-overrides.json in dev for pre-testing before Secret Manager deployment",
    "keys": [
      "DEBUG_LOCAL",
      "DEBUG_PROXY",
      "DEBUG_STREAMING",
      "LOCAL_PORT",
      "CLOUDFLARED_AUTO_START",
      "CLOUDFLARED_TUNNEL_PORT",
      "CLOUDFLARE_TOKEN",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ZONE_ID",
      "CLOUDFLARE_TUNNEL_NAME",
      "DEBUG_WALLET_ADDRESS",
      "CRYPTOAPIS_API_KEY",
      "HD_WALLET_MNEMONIC",
      "BTC_XPUB",
      "DOGE_XPUB",
      "GOOGLE_REDIRECT_URI",
      "POWCH_APP_URL",
      "POWCH_RP_ID",
      "POWCH_RP_NAME",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "STRIPE_PUBLISHABLE_KEY",
      "GMAIL_SENDER_EMAIL",
      "EMAIL_VERIFICATION_REQUIRED",
      "DESCIX_ROUTER_COMMUNITY_MANAGER",
      "DISCORD_BOT_URL",
      "POLYGON_RPC_URL",
      "MUMBAI_RPC_URL",
      "META_TX_RELAYER_KEY",
      "STORAGE_BUCKET",
      "APP_URL",
      "DEFAULT_COMMUNITY_ID",
      "DEFAULT_APP_ID",
      "DESCIX_ADMIN_GROUP",
      "POWCH_JWT_SECRET",
      "CLOUD_SCHEDULER_SA",
      "ENFORCE_ANY_TOKEN_GATE",
      "CORE_API_URL",
      "AIRDROP_BATCH_LIMIT",
      "AIRDROP_MAX_RUN_USERS",
      "AIRDROP_MAX_RETRIES",
      "AIRDROP_SCHEDULER_INTERVAL_SECONDS",
      "GET_PLATFORM_HOLDINGS_CACHE_TTL_SECONDS",
      "SERVICE_MANIFEST_TTL_SECONDS",
      "AIRDROP_COMMUNITY_IDS",
      "CRYPTOAPIS_WRITE_PATH_ENABLED",
      "BATCH_UPDATE_BALANCES_BROADCAST_ENABLED"
    ]
  },
  "defaults": {
    "description": "Keys with safe default values. Use SPARINGLY — prefer null to expose config errors. Only add here if the value is stable across all environments and has no security implications.",
    "values": {
      "UPVOTE_EMOJI": "👍",
      "DEFAULT_KNOWLEDGEBASE_NAME": "General",
      "VECTORIZE_MODE": "sync",
      "PINECONE_INTEGRATED_EMBED_MODEL": "llama-text-embed-v2",
      "PINECONE_NAMESPACE_MODE": "community_id",
      "PLATFORM_DEFAULT_CHAIN": "polygon",
      "DEFAULT_AI_MODEL": "gemini-2.0-flash",
      "CHAIN_DB_ID": "descix-chain",
      "DESCIX_ROUTER_PREFIX": "reply+",
      "AIRDROP_BATCH_LIMIT": 100,
      "AIRDROP_MAX_RUN_USERS": 500,
      "AIRDROP_MAX_RETRIES": 5,
      "AIRDROP_SCHEDULER_INTERVAL_SECONDS": 3600,
      "GET_PLATFORM_HOLDINGS_CACHE_TTL_SECONDS": 60,
      "SERVICE_MANIFEST_TTL_SECONDS": 60
    }
  }
}
